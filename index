function renderExtra(kind){const extra=$('record-extra');extra.replaceChildren();document.querySelector('.reading').classList.toggle('profile-card',kind==='profile');document.querySelector('.reading').classList.toggle('mbti-card',kind==='mbti');if(kind==='profile'){const dl=document.createElement('dl');dl.className='profile-facts';[['생일','2005.11.08'],['나이','만 '+ageToday()+'세'],['MBTI','ENFJ'],['학교','가천대학교 · 24학번']].forEach(([name,value])=>{const group=document.createElement('div'),dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=name;dd.textContent=value;group.append(dt,dd);dl.appendChild(group)});extra.appendChild(dl)}if(kind==='mbti'){const fig=document.createElement('figure');fig.className='mbti-figure';const img=document.createElement('img');img.src='data:image/svg+xml;base64,';img.alt='16Personalities의 ENFJ 선도자 대표 캐릭터';const caption=document.createElement('figcaption');caption.innerHTML='<strong>ENFJ</strong><p>사람들과 함께<br>밝은 에너지를 나눕니다.</p><a href="https://www.16personalities.com/enfj-personality" target="_blank" rel="noopener noreferrer">이미지 출처 · 16Personalities</a>';fig.append(img,caption);extra.appendChild(fig)}}
function showRecord(n){n=Math.max(0,Math.min(records.length-1,n));if(current!==n){current=n;pageIndex=0}const r=records[n],pages=recordPages(n),isEnd=r.kind==='ending';document.querySelector('.world-area').classList.toggle('at-end',isEnd);document.querySelector('.reading').hidden=isEnd;$('ending-message').hidden=!isEnd;document.querySelector('.scene-caption').hidden=isEnd;pageIndex=Math.min(pageIndex,pages.length-1);$('record-category').textContent=r.cat;$('record-title').textContent=r.title;$('record-tags').replaceChildren(...r.tags.map(tag=>{const el=document.createElement('span');el.className='tag';el.textContent=tag;return el}));renderExtra(r.kind);$('record-description').textContent=pages[pageIndex];$('record-number').textContent='RECORD '+String(n+1).padStart(2,'0');$('location-type').textContent=r.cat.split(' / ')[0];$('location-name').textContent=r.short;$('world-position').textContent=String(n+1).padStart(2,'0')+' / '+String(records.length).padStart(2,'0');$('daily-tools').hidden=r.kind!=='hobbies';$('card-pager').hidden=pages.length===1;$('page-label').textContent=(pageIndex+1)+' / '+pages.length;$('page-prev').disabled=pageIndex===0;$('page-next').disabled=pageIndex===pages.length-1;$('next-record').textContent=isEnd?'캐릭터 선택':'다음 기록으로 →';document.querySelectorAll('.station-btn').forEach((b,i)=>{b.classList.toggle('active',i===n);if(i===n)b.setAttribute('aria-current','step');else b.removeAttribute('aria-current')})}
