window.addEventListener('keydown',e=>{if(modalOpen())return;const k=e.key.toLowerCase();if(!entered){if(k==='arrowleft'){e.preventDefault();selectRole(role-1)}if(k==='arrowright'){e.preventDefault();selectRole(role+1)}return}if(['arrowleft','arrowright','a','d'].includes(k)){e.preventDefault();held.add(k);targetX=null}});
window.addEventListener('keyup',e=>held.delete(e.key.toLowerCase()));window.addEventListener('blur',clearMovement);document.addEventListener('visibilitychange',()=>{if(document.hidden)clearMovement()});
function holdButton(id,dir){const b=$(id);b.addEventListener('pointerdown',e=>{e.preventDefault();b.setPointerCapture(e.pointerId);pointerDir=dir;targetX=null});const release=()=>pointerDir=0;b.addEventListener('pointerup',release);b.addEventListener('pointercancel',release);b.addEventListener('lostpointercapture',release)}holdButton('move-left',-1);holdButton('move-right',1);
function resizeWorld(){if(!entered)return;const box=world.getBoundingClientRect();width=box.width;height=box.height;const dpr=Math.min(window.devicePixelRatio||1,2);world.width=Math.max(1,Math.round(width*dpr));world.height=Math.max(1,Math.round(height*dpr));ctx.setTransform(dpr,0,0,dpr,0,0);ctx.imageSmoothingEnabled=false;cameraX=playerX-width*.35;if(current>=0)showRecord(current)}
new ResizeObserver(resizeWorld).observe(world);
function cloud(x,y,s){rect(ctx,x,y,44*s,10*s,'#e8f3e8');rect(ctx,x+8*s,y-8*s,25*s,8*s,'#e8f3e8');rect(ctx,x+17*s,y-14*s,13*s,6*s,'#e8f3e8')}
function plant(c,x,y,s=1){rect(c,x,y,20*s,17*s,'#ce7864');rect(c,x-3*s,y-4*s,26*s,5*s,'#b96051');rect(c,x+8*s,y-33*s,4*s,30*s,'#5e826b');rect(c,x-2*s,y-26*s,11*s,7*s,'#75977d');rect(c,x+12*s,y-35*s,12*s,7*s,'#75977d')}
function laptop(c,x,y,s=1){rect(c,x,y,70*s,45*s,'#293e42');rect(c,x+5*s,y+5*s,60*s,35*s,'#d9ece8');rect(c,x+13*s,y+12*s,23*s,4*s,'#78adbd');rect(c,x+13*s,y+23*s,43*s,3*s,'#a3bdb2');rect(c,x-8*s,y+45*s,86*s,7*s,'#587b85')}
function drawProp(type,x,floor){
 const y=floor-94;
 if(type==='desk'||type==='video'||type==='web'){rect(ctx,x-66,y+60,140,8,'#99744f');rect(ctx,x-57,y+68,8,26,'#99744f');rect(ctx,x+51,y+68,8,26,'#99744f');laptop(ctx,x-30,y+8);if(type==='desk'){plant(ctx,x-62,y+42,.7);rect(ctx,x+48,y+51,16,7,'#f4cd55')}if(type==='video'){rect(ctx,x+51,y-12,29,45,'#293e42');rect(ctx,x+55,y-7,21,34,'#f4cd55');rect(ctx,x+61,y+5,9,9,'#ce7864')}if(type==='web'){rect(ctx,x-24,y+20,48,18,'#f4cd55');rect(ctx,x-18,y+25,19,4,'#293e42')}}
 else if(type==='filter'){rect(ctx,x-31,y-38,64,102,'#293e42');rect(ctx,x-24,y-29,50,81,'#fffdf1');drawAvatar(ctx,x-15,y-23,2,0);rect(ctx,x-25,y+62,52,6,'#ce7864');rect(ctx,x-16,y+68,5,26,'#ce7864');rect(ctx,x+14,y+68,5,26,'#ce7864')}
 else if(type==='award'){rect(ctx,x-24,y+72,54,22,'#75977d');rect(ctx,x-17,y+51,40,21,'#f4cd55');rect(ctx,x-6,y+27,17,24,'#d8ad33');rect(ctx,x-22,y-10,50,37,'#f4cd55');rect(ctx,x-32,y-4,10,19,'#d8ad33');rect(ctx,x+28,y-4,10,19,'#d8ad33');rect(ctx,x-9,y+3,23,5,'#fff0a7')}
 else{rect(ctx,x-61,y-29,130,91,'#99744f');rect(ctx,x-55,y-23,118,79,'#f9f5d9');[['#f4cd55',-43,-10],['#78adbd',-3,-10],['#ce7864',-43,23],['#8ca47f',-3,23]].forEach(([color,a,b])=>{rect(ctx,x+a,y+b,30,23,color);rect(ctx,x+a+5,y+b+7,18,3,'#fffdf1')});rect(ctx,x-46,y+62,7,32,'#99744f');rect(ctx,x+43,y+62,7,32,'#99744f');if(type==='platform'){rect(ctx,x+11,y-10,32,56,'#293e42');rect(ctx,x+15,y-6,24,48,'#d9ece8');rect(ctx,x+18,y+1,18,12,'#f4cd55')}}
}
function drawScene(t,dir){
 rect(ctx,0,0,width,height,'#a6d9e4');const floor=Math.floor(height*.78);
 const sunX=width-75-cameraX*.018;rect(ctx,sunX,55,34,34,'#fff0a7');rect(ctx,sunX+7,48,20,7,'#fff0a7');rect(ctx,sunX+7,89,20,7,'#fff0a7');
 for(let i=-1;i<8;i++){let x=i*225-((cameraX*.12)%225);cloud(x,55+(i%3)*25,1)}
 for(let i=-1;i<12;i++){let x=i*160-((cameraX*.22)%160);rect(ctx,x,floor-55,160,65,'#a1bf9d');rect(ctx,x+20,floor-72,118,20,'#a1bf9d');rect(ctx,x+43,floor-88,73,20,'#a1bf9d')}
 rect(ctx,0,floor,width,height-floor,'#d6dfb9');rect(ctx,0,floor,width,8,'#75977d');rect(ctx,0,floor+8,width,5,'#a2b889');
 for(let i=-2;i<20;i++){const x=i*65-((cameraX*.8)%65);rect(ctx,x,floor+37,22,4,'#b6c79f');rect(ctx,x+25,floor+65,12,3,'#becba6')}
 for(let i=0;i<records.length;i++){const x=START+STEP*i-cameraX;if(x< -220||x>width+220)continue;const objectX=x+132;if(records[i].kind!=='ending')drawProp(records[i].prop,objectX,floor);rect(ctx,x-80,floor+13,170,3,'#c39a54');rect(ctx,x-80,floor+16,6,14,'#c39a54');rect(ctx,x+84,floor+16,6,14,'#c39a54');ctx.fillStyle='#44674e';ctx.font='11px "Malgun Gothic",sans-serif';ctx.textAlign='center';ctx.fillText(records[i].short,x+4,floor+47);if(i%2===0)plant(ctx,x-113,floor-18,.85)}
 const px=playerX-cameraX,s=Math.max(2.6,Math.min(5,height/100));rect(ctx,px-8,floor-4,16*s,5,'#597b5b33');drawAvatar(ctx,px-8*s,floor-23*s,s,role,dir?walkClock:0,dir<0?-1:1);

 $('progress').style.width=((playerX-START)/(END-START)*100)+'%';
}
function frame(time){const dt=Math.min((time-lastFrame)/1000||0,.04);lastFrame=time;if(entered&&!modalOpen()){let dir=pointerDir+(held.has('arrowright')||held.has('d')?1:0)-(held.has('arrowleft')||held.has('a')?1:0);dir=Math.sign(dir);playerX=Math.max(START,Math.min(END,playerX+dir*325*dt));if(dir)walkClock+=dt*12;const desired=playerX-width*.35;cameraX+= (desired-cameraX)*Math.min(1,dt*10);const n=Math.round((playerX-START)/STEP);if(n!==current)showRecord(n);drawScene(time,dir)}requestAnimationFrame(frame)}requestAnimationFrame(frame);
let lastDialogTrigger=null;
function openDialog(id,trigger){clearMovement();lastDialogTrigger=trigger;$(id).showModal();$(id).querySelector('[data-close]').focus()}
$('open-desk').onclick=()=>openDialog('desk-dialog',$('open-desk'));$('open-memo').onclick=()=>openDialog('memo-dialog',$('open-memo'));
document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>b.closest('dialog').close());document.querySelectorAll('dialog').forEach(d=>{d.addEventListener('close',()=>{clearMovement();lastDialogTrigger?.focus({preventScroll:true})});d.addEventListener('click',e=>{if(e.target===d){const r=d.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)d.close()}})});
// 책상 물건 위치는 비율로 보관하여 모바일에서도 책상 안에 유지됩니다.
const deskItems=[{name:'노트북',kind:'laptop',x:.12,y:.25},{name:'노란 책',kind:'book',x:.56,y:.5},{name:'연필',kind:'pencil',x:.73,y:.08},{name:'화분',kind:'plant',x:.35,y:.02},{name:'메모',kind:'note',x:.03,y:.64}];
let deskSaved;
try{deskSaved=JSON.parse(localStorage.getItem('pixelPortfolioDesk')||'null')}catch{}
function drawItem(canvas,kind){const c=canvas.getContext('2d');c.clearRect(0,0,64,64);c.imageSmoothingEnabled=false;if(kind==='laptop')laptop(c,10,14,.6);if(kind==='plant')plant(c,23,43,1);if(kind==='book'){rect(c,12,12,39,44,'#ad8317');rect(c,16,8,39,44,'#f4cd55');rect(c,20,14,4,32,'#fff0a7');rect(c,29,18,18,4,'#fffdf1')}if(kind==='pencil'){rect(c,27,9,10,42,'#f4cd55');rect(c,27,5,10,7,'#ce7864');rect(c,29,51,6,7,'#efbe93');rect(c,31,58,2,3,'#293e42')}if(kind==='note'){rect(c,12,12,42,42,'#f4cd55');rect(c,18,23,29,3,'#ad8317');rect(c,18,32,23,3,'#ad8317');rect(c,18,41,27,3,'#ad8317')}}
function layoutDesk(){const d=$('desk');deskItems.forEach(item=>{item.el.style.left=(item.x*Math.max(0,d.clientWidth-item.el.offsetWidth))+'px';item.el.style.top=(item.y*Math.max(0,d.clientHeight-item.el.offsetHeight))+'px'})}
deskItems.forEach((item,i)=>{if(Array.isArray(deskSaved)&&deskSaved[i]&&Number.isFinite(deskSaved[i].x)&&Number.isFinite(deskSaved[i].y)){item.x=Math.max(0,Math.min(1,deskSaved[i].x));item.y=Math.max(0,Math.min(1,deskSaved[i].y))}const b=document.createElement('button');b.className='desk-item';b.setAttribute('aria-label',item.name+' 옮기기');const c=document.createElement('canvas');c.width=64;c.height=64;drawItem(c,item.kind);const label=document.createElement('span');label.textContent=item.name;b.append(c,label);$('desk').appendChild(b);item.el=b;let drag=null;b.addEventListener('pointerdown',e=>{e.preventDefault();b.focus();b.setPointerCapture(e.pointerId);drag={x:e.clientX,y:e.clientY,left:b.offsetLeft,top:b.offsetTop};b.style.zIndex='3'});b.addEventListener('pointermove',e=>{if(!drag)return;const maxX=$('desk').clientWidth-b.offsetWidth,maxY=$('desk').clientHeight-b.offsetHeight;item.x=Math.max(0,Math.min(maxX,drag.left+e.clientX-drag.x))/Math.max(1,maxX);item.y=Math.max(0,Math.min(maxY,drag.top+e.clientY-drag.y))/Math.max(1,maxY);layoutDesk()});const stop=()=>{drag=null;b.style.zIndex='1'};b.addEventListener('pointerup',stop);b.addEventListener('pointercancel',stop);b.addEventListener('lostpointercapture',stop);b.addEventListener('keydown',e=>{const dirs={ArrowLeft:[-1,0],ArrowRight:[1,0],ArrowUp:[0,-1],ArrowDown:[0,1]};if(dirs[e.key]){e.preventDefault();const [dx,dy]=dirs[e.key];item.x=Math.max(0,Math.min(1,item.x+dx*.04));item.y=Math.max(0,Math.min(1,item.y+dy*.06));layoutDesk()}})});
new ResizeObserver(layoutDesk).observe($('desk'));
$('desk-reset').onclick=()=>{[[.12,.25],[.56,.5],[.73,.08],[.35,.02],[.03,.64]].forEach(([x,y],i)=>{deskItems[i].x=x;deskItems[i].y=y});layoutDesk();$('desk-status').textContent='처음 배치로 돌아왔습니다.'};
$('desk-save').onclick=()=>{try{localStorage.setItem('pixelPortfolioDesk',JSON.stringify(deskItems.map(({x,y})=>({x,y}))));$('desk-status').textContent='이 브라우저에 책상 배치를 저장했습니다.'}catch{$('desk-status').textContent='브라우저 저장을 사용할 수 없습니다. 현재 배치는 페이지를 열어둔 동안 유지됩니다.'}};
const memo=$('memo'),mc=memo.getContext('2d');let drawing=false,penColor='#e9b521',erasing=false;
function clearMemo(){mc.fillStyle='#ffffff';mc.fillRect(0,0,memo.width,memo.height)}clearMemo();
function memoPoint(e){const r=memo.getBoundingClientRect();return[(e.clientX-r.left)*memo.width/r.width,(e.clientY-r.top)*memo.height/r.height]}
memo.addEventListener('pointerdown',e=>{e.preventDefault();drawing=true;memo.setPointerCapture(e.pointerId);const [x,y]=memoPoint(e);mc.lineCap='round';mc.lineJoin='round';mc.lineWidth=Number($('pen-size').value)*2;mc.strokeStyle=erasing?'#ffffff':penColor;mc.fillStyle=mc.strokeStyle;mc.beginPath();mc.arc(x,y,mc.lineWidth/2,0,Math.PI*2);mc.fill();mc.beginPath();mc.moveTo(x,y)});
memo.addEventListener('pointermove',e=>{if(!drawing)return;const [x,y]=memoPoint(e);mc.lineTo(x,y);mc.stroke();mc.beginPath();mc.moveTo(x,y)});['pointerup','pointercancel','lostpointercapture'].forEach(type=>memo.addEventListener(type,()=>drawing=false));
document.querySelectorAll('[data-color]').forEach(b=>b.onclick=()=>{penColor=b.dataset.color;erasing=false;$('eraser').setAttribute('aria-pressed','false');document.querySelectorAll('[data-color]').forEach(s=>s.setAttribute('aria-pressed',String(s===b)))});
$('eraser').onclick=()=>{erasing=!erasing;$('eraser').setAttribute('aria-pressed',String(erasing))};$('memo-clear').onclick=clearMemo;
$('memo-download').onclick=()=>{const a=document.createElement('a');a.download='나의-노란-메모.png';a.href=memo.toDataURL('image/png');a.click();toast('노란 메모 PNG를 저장합니다.')};
</script>
