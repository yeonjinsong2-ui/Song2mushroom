function drawAvatar(c,x,y,s,r,step=0,face=1){
 if(!spriteSheet.complete||!spriteSheet.naturalWidth)return;
 const frame=step?1+(Math.floor(step/Math.PI)%2):0,cell=spriteSheet.naturalWidth/3;
